{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    // Tests run directly through node --test --experimental-strip-types, which
    // resolves real file paths, so their relative imports carry a .ts suffix.
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
