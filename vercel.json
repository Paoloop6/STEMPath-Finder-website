{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/stempathfinder run build && node artifacts/api-server/build-serverless.mjs",
  "outputDirectory": "artifacts/stempathfinder/dist/public",
  "trailingSlash": false,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/app.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/match",
      "destination": "/app.html"
    },
    {
      "source": "/results",
      "destination": "/app.html"
    },
    {
      "source": "/docs",
      "destination": "/app.html"
    }
  ]
}
