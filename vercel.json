{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/stempathfinder run build && node artifacts/api-server/build-serverless.mjs",
  "outputDirectory": "artifacts/stempathfinder/dist/public",
  "trailingSlash": false,
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/opportunities/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/match", "destination": "/index.html" },
    { "source": "/results", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" }
  ]
}
